<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and older. The credentials are encrypted with a Keystore key that
     never leaves the device, so a restored copy can't be read: leave them out and the user
     connects again. Everything else is still backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="calibre_creds.xml" />
    <!-- This phone's notification state (its Do Not Disturb rule, last book opened, booked
         reminder) and the new-books ids: restored elsewhere they would be wrong, and the ids would
         announce every book added since the backup instead of recording a fresh baseline. -->
    <exclude domain="sharedpref" path="notification_device.xml" />
    <exclude domain="sharedpref" path="new_books_seen.xml" />
</full-backup-content>
