<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and older. The credentials are encrypted with a Keystore key that
     never leaves the device, so a restored copy can't be read: leave them out and the user
     connects again. Everything else is still backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="calibre_creds.xml" />
</full-backup-content>
