<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The starting window only; Compose owns the colours and the system bars after onCreate. -->
    <style name="Theme.Quire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/quire_surface</item>
        <item name="android:statusBarColor">@color/quire_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/quire_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="Theme.Quire.Launch" parent="Theme.Quire">
        <item name="android:windowBackground">@drawable/quire_starting_window</item>
    </style>
</resources>
