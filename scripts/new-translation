#!/usr/bin/env python3
"""Create editable Android XML for a new UI locale without changing app code."""
import argparse
from pathlib import Path
import re
import shutil
import tempfile
import xml.etree.ElementTree as ET

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('locale', help='Android locale qualifier, for example pt, pt-rBR or b+zh+Hans')
args = parser.parse_args()
if not re.fullmatch(r'(?:[a-z]{2,3}(?:-r[A-Z]{2})?|b\+[a-z]{2,3}(?:\+[A-Za-z0-9]{2,8})*)', args.locale):
    parser.error('Use a locale qualifier, without values- or a path.')
res = Path(__file__).resolve().parents[1] / 'app/src/main/res'
destination = res / ('values-' + args.locale)
if destination.exists():
    parser.error(f'{destination.name} already exists. Edit its XML files directly; nothing was changed.')
# Stage first so a parsing failure cannot leave a half-created locale.
staging = Path(tempfile.mkdtemp(prefix='.translation-', dir=res))
count = 0
try:
    for source in sorted((res / 'values').glob('*.xml')):
        tree = ET.parse(source, parser=ET.XMLParser(target=ET.TreeBuilder(insert_comments=True)))
        root = tree.getroot()
        for child in list(root):
            if child.tag is ET.Comment:
                continue
            if child.tag not in ('string', 'plurals', 'string-array') or child.get('translatable') == 'false':
                root.remove(child)
        entries = [child for child in root if child.tag in ('string', 'plurals', 'string-array')]
        if not entries:
            continue
        count += len(entries)
        root.insert(0, ET.Comment(' English source text. Translate every entry before submitting. See docs/translating.md. '))
        ET.indent(tree, space='    ')
        tree.write(staging / source.name, encoding='utf-8', xml_declaration=True)
        with (staging / source.name).open('ab') as output:
            output.write(b'\n')
    staging.rename(destination)
finally:
    if staging.exists():
        shutil.rmtree(staging)
print(f'Created {destination.relative_to(res.parent.parent.parent.parent)} with {count} English source resources.')
print('Translate the XML, then run: scripts/dgradle :app:testDebugUnitTest --tests "*StringParityTest"')
