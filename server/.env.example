# Copy to .env and fill in. Do not commit .env.
#
# Both compose files load this file wholesale (env_file), so every
# QUIRE_SERVER_* line here reaches the server. Lines starting with # are
# ignored; delete the # to activate a setting. For the AI provider
# variables an empty value counts as unset. A name the server does not
# recognise is reported at boot as "Unknown setting ... is ignored" and
# listed under `warnings` in GET /health.
#
# The tag on the line above each variable says how much it matters:
#   [required]      the stack does not work without it
#   [compose-only]  not one of the server's settings; read by docker
#                   compose or another container (an exception is noted
#                   where the server still picks it up from the OS)
#   [mode]          turns whole feature areas on or off
#   [ai]            AI provider connection, needed when AI is on
#   [tuning]        timeouts and quotas with sensible defaults
#   [advanced]      leave alone unless server/README.md sends you here

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# [required] Password for the bundled Postgres.
POSTGRES_PASSWORD=change-me
# [required, minimal compose only] Your existing calibre-web URL. The
# full-stack compose ignores this line and wires its own calibre-web.
QUIRE_SERVER_CWA_BASE_URL=https://library.example.com

# ---------------------------------------------------------------------------
# Not server settings (docker compose and other containers)
# ---------------------------------------------------------------------------
# [compose-only, minimal] Host port the server is published on.
QUIRE_SERVER_PORT=8000
# [compose-only, full stack] Hostname Caddy serves on. Keep `localhost` for
# the self-signed (`tls internal`) setup. For a real certificate set your
# public hostname AND replace `tls internal` in caddy/Caddyfile (README).
QUIRE_SITE_ADDRESS=localhost
# [compose-only, full stack] Override only if 443/80 are taken on the host.
CADDY_HTTPS_PORT=443
CADDY_HTTP_PORT=80
# [compose-only, full stack] calibre-web file-ownership mapping.
PUID=1000
PGID=1000
# [compose-only] Clock zone for every container that reads it. Both
# compose files now load this file into quire-server too, so the server
# reports timestamps such as server_time in GET /sync/v1/progress at this
# offset instead of UTC.
TZ=UTC

# ---------------------------------------------------------------------------
# Deploy mode
# ---------------------------------------------------------------------------
# [mode] Reading-progress sync and library endpoints (/sync/v1, /library/v1).
QUIRE_SERVER_PROGRESS_ENABLED=true
# [mode] AI insights (/ai/v1). When true, fill in the [ai] block below or
# the server boots with a warning and the app reports AI as unconfigured.
QUIRE_SERVER_AI_ENABLED=true
# [mode] `calibreweb` checks credentials against calibre-web (default).
# `native` keeps its own users, for deploys without calibre-web (README,
# "AI auth mode").
QUIRE_SERVER_AUTH_BACKEND=calibreweb
# [tuning] Log level: DEBUG, INFO, WARNING, ERROR.
QUIRE_SERVER_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AI provider (needed when QUIRE_SERVER_AI_ENABLED=true)
# ---------------------------------------------------------------------------
# [ai] Any OpenAI-compatible endpoint, including the /v1 suffix.
#   Ollama cloud (free tier works):  https://ollama.com/v1
#   Ollama on the Docker host:       http://host.docker.internal:11434/v1
#   OpenAI:                          https://api.openai.com/v1
#QUIRE_SERVER_AI_BASE_URL=https://ollama.com/v1
# [ai] Model name as the provider knows it. Local Ollama: `ollama pull` first.
#QUIRE_SERVER_AI_MODEL=gpt-oss:120b-cloud
# [ai] API key. Leave unset for a local Ollama without auth. Never logged
# and never returned by any endpoint.
#QUIRE_SERVER_AI_API_KEY=
# [tuning] Seconds to wait for one model answer. The server retries once on
# malformed output, so one request can take up to twice this. A small model
# on a CPU-only host often needs 300 or more; cloud models finish well
# under 60. The app sizes its own wait from this value.
#QUIRE_SERVER_AI_TIMEOUT_S=120
# [tuning] Seconds for each Wikipedia / Open Library lookup.
#QUIRE_SERVER_AI_RETRIEVAL_TIMEOUT_S=8
# [tuning] Comma-separated retrieval sources (Wikipedia, Open Library).
# Empty disables retrieval, which also makes the prompt much shorter:
# the first thing to try when a small local model keeps timing out.
#QUIRE_SERVER_AI_SOURCES=wikipedia,openlibrary
# [tuning] Parallel model calls the server allows at once.
#QUIRE_SERVER_AI_MAX_CONCURRENCY=4

# ---------------------------------------------------------------------------
# AI quotas (defaults are fine for a household)
# ---------------------------------------------------------------------------
# [tuning] Process-wide calls per minute against the provider.
#QUIRE_SERVER_AI_RATE_PER_MIN=10
# [tuning] Per-user generations per UTC day. 0 disables the cap.
#QUIRE_SERVER_AI_DAILY_BUDGET=200
# [tuning] Per-user regenerations per UTC day.
#QUIRE_SERVER_AI_REGEN_DAILY_LIMIT=3
# [tuning] Per-user reader-profile refreshes per UTC day, and their timeout.
#QUIRE_SERVER_AI_PROFILE_REFRESH_DAILY_LIMIT=3
#QUIRE_SERVER_AI_PROFILE_TIMEOUT_S=90
# [tuning] Per-user insight promotions per UTC day (no model call).
#QUIRE_SERVER_AI_PROMOTE_DAILY_LIMIT=100

# ---------------------------------------------------------------------------
# Advanced (server/README.md, "Advanced and deprecated")
# ---------------------------------------------------------------------------
# [advanced] Prompt-version pin for incident rollback. "1" means unset.
#QUIRE_SERVER_AI_PROMPT_VERSION=
# [advanced] Token-mode AI auth is deprecated; prefer AUTH_BACKEND=native.
#QUIRE_SERVER_AI_AUTH_MODE=basic
# [advanced] Deprecated server-side metadata fallback; leave false.
#QUIRE_SERVER_AI_METADATA_SERVER_LOOKUP_ENABLED=false
